{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "D",
  "scopeName": "source.d",
  "fileTypes": ["d", "di"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#char" },
    { "include": "#numbers" },
    { "include": "#attributes" },
    { "include": "#manifest-constant" },
    { "include": "#keywords" },
    { "include": "#storage" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.d", "match": "///.*$" },
        { "name": "comment.line.double-slash.d", "match": "//.*$" },
        { "name": "comment.block.documentation.d", "begin": "/\\*[*!]", "end": "\\*/" },
        { "name": "comment.block.d", "begin": "/\\*", "end": "\\*/" },
        {
          "name": "comment.block.nested.d",
          "begin": "/\\+",
          "end": "\\+/",
          "patterns": [{ "include": "#comments" }]
        }
      ]
    },
    "token-body": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "begin": "\\{", "end": "\\}", "patterns": [{ "include": "#token-body" }] }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.raw.d", "begin": "r\"", "end": "\"" },
        { "name": "string.quoted.hex.d", "begin": "x\"", "end": "\"" },
        {
          "name": "string.quoted.token.d",
          "begin": "q\\{",
          "end": "\\}",
          "patterns": [{ "include": "#token-body" }]
        },
        {
          "name": "string.quoted.delimited.d",
          "begin": "q\"([^a-zA-Z0-9_\\s])",
          "end": "\\1\""
        },
        { "name": "string.quoted.other.backtick.d", "begin": "`", "end": "`" },
        {
          "name": "string.quoted.double.d",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.d", "match": "\\\\." }]
        }
      ]
    },
    "char": {
      "name": "string.quoted.single.d",
      "begin": "'",
      "end": "'",
      "patterns": [{ "name": "constant.character.escape.d", "match": "\\\\." }]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.d",
          "match": "\\b0[xX][0-9a-fA-F_]+(\\.[0-9a-fA-F_]*)?([pP][+\\-]?[0-9_]+)?[fFLuUiI]*\\b"
        },
        { "name": "constant.numeric.binary.d", "match": "\\b0[bB][01_]+[fFLuUiI]*\\b" },
        {
          "name": "constant.numeric.float.d",
          "match": "\\b(\\d[\\d_]*\\.\\d[\\d_]*([eE][+\\-]?\\d[\\d_]*)?|\\d[\\d_]*[eE][+\\-]?\\d[\\d_]*|\\d[\\d_]*\\.)[fFLiI]*\\b"
        },
        { "name": "constant.numeric.integer.d", "match": "\\b\\d[\\d_]*[uUL]*\\b" }
      ]
    },
    "attributes": {
      "patterns": [
        { "name": "storage.modifier.attribute.d", "match": "@[a-zA-Z_][a-zA-Z0-9_]*" }
      ]
    },
    "manifest-constant": {
      "patterns": [
        {
          "match": "\\b(enum)\\s+(?:[A-Za-z_][A-Za-z0-9_.!]*\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
          "captures": {
            "1": { "name": "keyword.other.d" },
            "2": { "name": "variable.other.constant.d" },
            "3": { "name": "keyword.operator.d" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.d",
          "match": "\\b(if|else|while|do|for|foreach|foreach_reverse|switch|case|default|break|continue|return|goto|with|try|catch|finally|throw|scope|synchronized|version|debug|static|is|cast|new|delete|typeof|typeid|mixin|import|module|assert|unittest|invariant|in|out|body|asm|extern)\\b"
        },
        {
          "name": "keyword.other.d",
          "match": "\\b(alias|typedef|enum|class|struct|union|interface|template|this|super|ref|auto|lazy|pragma|align|export|package|public|private|protected|final|abstract|override|deprecated|pure|nothrow|immutable|const|inout|shared|__gshared|__traits|__vector|__parameters|__va_list|macro|__unittest)\\b"
        }
      ]
    },
    "storage": {
      "patterns": [
        {
          "name": "storage.type.d",
          "match": "\\b(bool|byte|ubyte|short|ushort|int|uint|long|ulong|cent|ucent|float|double|real|char|wchar|dchar|void|ifloat|idouble|ireal|string|wstring|dstring|size_t|ptrdiff_t|noreturn)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.d",
          "match": "\\b(true|false|null|__FILE__|__LINE__|__FUNCTION__|__MODULE__|__DATE__|__TIME__|__TIMESTAMP__|__VENDOR__|__VERSION__)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "entity.name.function.d", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "entity.name.type.d", "match": "\\b(?![A-Z0-9_]*_[A-Z0-9_]*\\b)[A-Z][a-zA-Z0-9_]*\\b" }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.d",
          "match": "(<<=|>>=|\\.\\.\\.|\\*=|\\+=|-=|/=|%=|&=|\\|=|\\^=|=>|\\.\\.|!<>|<>|<=|>=|==|!=|&&|\\|\\||<<|>>|\\+\\+|--|~=|\\?=|\\^\\^)"
        },
        { "name": "keyword.operator.d", "match": "[+\\-*/%<>=!&|^~?:]" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.definition.block.d", "match": "[{}]" },
        { "name": "punctuation.definition.parameters.d", "match": "[()]" },
        { "name": "punctuation.definition.array.d", "match": "[\\[\\]]" },
        { "name": "punctuation.terminator.statement.d", "match": ";" },
        { "name": "punctuation.separator.d", "match": "[,.]" }
      ]
    }
  }
}
